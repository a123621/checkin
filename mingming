          <button class="record-del" onclick="App.deleteRecord('shopping', '${date}', '${item.id}')">删</button>
        </div>
      </div>`;
    });
    container.innerHTML = html || '<div style="text-align:center;color:var(--text-secondary);padding:20px 0;">今天还没有购物记录哦</div>';
    document.getElementById('shopping-day-total').innerText = Util.formatMoney(dayTotal);
  },
  
  renderDiet() {
    const date = Calendar.selectedDate;
    const list = Store.data.records.diet[date] || [];
    const container = document.getElementById('diet-list');
    const catColors = { meal: '#4CAF7D', snack: '#F0A030', drink: '#4A9BE8', feast: '#E05C5C' };
    const catSymbols = { meal: '🍚', snack: '🍪', drink: '🥤', feast: '🍖' };
    let html = '';
    let dayTotal = 0;
    list.forEach(item => {
      dayTotal += item.price;
      const color = catColors[item.cat] || catColors.meal;
      const sym = catSymbols[item.cat] || catSymbols.meal;
      html += `<div class="record-item">
        <div class="record-left">
          <div class="record-cat-bar" style="background:${color};"></div>
          <span>${sym}</span> ${item.name}
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
          <span style="color:var(--theme-solid);font-weight:600;">${Util.formatMoney(item.price)}</span>
          <button class="record-del" onclick="App.deleteRecord('diet', '${date}', '${item.id}')">删</button>
        </div>
      </div>`;
    });
    container.innerHTML = html || '<div style="text-align:center;color:var(--text-secondary);padding:20px 0;">今天还没有饮食记录哦</div>';
    document.getElementById('diet-day-total').innerText = Util.formatMoney(dayTotal);
    
    // 周合计
    const weekRange = Util.getWeekRange(date);
    let weekTotal = 0;
    weekRange.forEach(d => {
      const recs = Store.data.records.diet[d] || [];
      recs.forEach(r => weekTotal += r.price);
    });
    document.getElementById('diet-week-total').innerText = `本周合计: ${Util.formatMoney(weekTotal)}`;
  },
  
